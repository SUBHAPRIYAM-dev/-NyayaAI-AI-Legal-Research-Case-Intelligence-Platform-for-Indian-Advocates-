# ============================================================
# NYAYAAI ENVIRONMENT VARIABLES
# ============================================================

# Database (PostgreSQL + pgvector ready)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nyayaai?schema=public"

# Cache & Queues (Redis)
REDIS_URL="redis://localhost:6379"

# AI Configuration (Google Gemini)
# Leave blank to run in automatic deterministic DEMO AI MODE
GEMINI_API_KEY=""

# Security & Authentication
JWT_SECRET="nyayaai-super-secure-jwt-secret-key-32-chars-min-change-in-prod"
COOKIE_NAME="nyayaai_session"
NODE_ENV="development"

# Object Storage (S3 / R2 / MinIO abstraction)
STORAGE_BUCKET="nyayaai-documents"
STORAGE_REGION="ap-south-1"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Billing & Payments (Razorpay & Stripe mock/live adapters)
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email Notifications
EMAIL_PROVIDER="mock"
EMAIL_API_KEY=""
EMAIL_FROM="notifications@nyayaai.test"
